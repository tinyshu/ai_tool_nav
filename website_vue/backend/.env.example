# 复制为 .env 后填写真实值，勿提交 .env

NODE_ENV=production
PORT=3000

# 必填：随机长字符串，用于登录 JWT
JWT_SECRET=请换成足够长的随机密钥

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=website
DB_PASSWORD=
DB_NAME=website_vue_node

# 前后端同域（Express 托管 dist）时可留空
# 若管理端/官网与 API 不同源，填写允许的 Origin，逗号分隔
# 例：https://corp.你的导航域名.com
CORS_ORIGIN=

# 置于 Nginx 等反向代理后设为 1
TRUST_PROXY=1

# 非 production 时若也要托管前端，设为 1
# SERVE_FRONTEND=1
